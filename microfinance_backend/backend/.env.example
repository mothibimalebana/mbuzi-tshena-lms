# Flask
FLASK_APP=run.py
FLASK_ENV=production
SECRET_KEY=change-this-secret-key-in-production
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# Database
POSTGRES_USER=microfinance
POSTGRES_PASSWORD=microfinance_pw
POSTGRES_DB=microfinance_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://microfinance:microfinance_pw@postgres:5432/microfinance_db

# Redis
REDIS_URL=redis://redis:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000

# Admin seed
DEFAULT_ADMIN_EMAIL=admin@system.com
DEFAULT_ADMIN_PASSWORD=Admin123!
